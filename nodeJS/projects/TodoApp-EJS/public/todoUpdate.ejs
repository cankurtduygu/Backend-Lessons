<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <title>Todo Update</title>
  </head>
  <body>
    <div class="container">
      <h1 class="mt-3">FullStack Todo Template Project</h1>
      <hr />
      <div class="rows">
        <h2>TODO UPDATE</h2>
        <a class="btn btn-link" href="/view"> <- Go back</a>
        <form action="/view/<%= todo.id %>/update" method="post">
          <table class="table table-striped">
            <tr>
              <td>Title:</td>
              <td>
                <input
                  type="text"
                  name="title"
                  value="<%= todo.title %>"
                  class="form-control"
                  placeholder="Enter title"
                />
              </td>
            </tr>
            <tr>
              <td>Description:</td>
              <td>
                <textarea name="description" class="form-control">
                    <%= todo.description %></textarea
                >
              </td>
            </tr>
            <tr>
              <td>Priority:</td>
              <td>
                <select name="priority" id="priority" class="form-select">
                  <option value="-1" <%= todo.priority == -1 ? "selected" : "" %>>Low</option>
<option value="0" <%= todo.priority == 0 ? "selected" : "" %>>Normal</option>
<option value="1" <%= todo.priority == 1 ? "selected" : "" %>>High</option>
                </select>
              </td>
            </tr>
          </table>
          <button type="submit" class="btn btn-primary">Update Todo</button>
        </form>
      </div>
    </div>
  </body>
</html>
