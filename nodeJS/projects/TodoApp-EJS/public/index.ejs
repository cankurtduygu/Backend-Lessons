<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <title>Todo App</title>
  </head>
  <body>
    <div class="container">
      <h1 class="mt-3">FullStack Todo Template Project</h1>
      <hr />
      <div class="rows">
        <h2>TODO LIST</h2>
        <p>Count: <%= count %> </p>
        <table class="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>Title</th>
              <th>Description</th>
              <th>Priority</th>
              <th>isDone</th>
              <th>CreatedAt</th>
              <th><a href="/view/create" class="btn btn-primary">CREATE</a></th>
            </tr>
          </thead>
          <tbody>
            <% for (let todo of todos) { %>
            <tr>
                <td># <%= todo.id %> </td>
                <td><%= todo.title %></td>
                <td class="text-truncate" style='max-width:20px'><%= todo.description %></td>
                <td><%= priorities[todo.priority] %></td>
                <td><%- todo.isDone  ? "<span class='text-success'>YES</span>" : "<span class='text-danger'>NO</span>" %> </td>
                <td><%= todo.createdAt.toLocaleDateString('tr') %></td>
                <td class="">
                    <a class="btn btn-sm btn-secondary" href="/view/<%= todo.id %>">Read</a>
                    <a class="btn btn-sm btn-primary" href="/view/<%= todo.id %>/update">Update</a>
                    <!-- <a class="btn btn-sm btn-danger" href="/view/<%= todo.id %>/delete">Delete</a> -->
                    <button class="btn btn-sm btn-danger" onClick="if(confirm('Are sure about this ?')) {window.location.href='/view/<%= todo.id %>/delete'}" >Delete</button>
                </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>